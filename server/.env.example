# Copy to server/.env and fill in. Never commit the filled-in file.
#   cp server/.env.example server/.env

# ---- Required ----------------------------------------------------------
# The interview agents will not run without this.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Model -------------------------------------------------------------
# The only place the model id is configured; nothing hardcodes it.
CLAUDE_MODEL=claude-sonnet-5

# ---- Tavus avatar (optional) -------------------------------------------
# Needed only when ENABLE_AVATAR=true. https://tavus.io/dashboard
TAVUS_API_KEY=
TAVUS_REPLICA_ID=

# ---- LiveKit (optional) ------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Email reports (optional) ------------------------------------------
# Needed only when ENABLE_EMAIL_NOTIFICATIONS=true.
# For Gmail use an App Password, not your account password:
# https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
MANAGER_EMAIL=

# ---- Feature flags -----------------------------------------------------
# Set the avatar/email flags to false to run without those credentials.
ENABLE_AVATAR=true
ENABLE_LIVEKIT=true
ENABLE_EMAIL_NOTIFICATIONS=true
SAVE_TRANSCRIPTS=true

# ---- Interview shape ---------------------------------------------------
MAX_INTERVIEW_DURATION=45
WARMUP_QUESTIONS=2
CORE_QUESTIONS=5
ADVANCED_QUESTIONS=3
