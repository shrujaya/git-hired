# Copy to server/.env and fill in. Never commit the filled-in file.
#   cp server/.env.example server/.env

# ---- Required ----------------------------------------------------------
# The interview agents will not run without this.
# Get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# ---- Server ------------------------------------------------------------
# Where the backend listens. 127.0.0.1 keeps it local; use 0.0.0.0 to expose
# it on your network (Windows will prompt for a firewall exception).
# If you change PORT, set VITE_API_BASE_URL in agentic-interviewer/.env.local
# to match, e.g. http://localhost:8200
HOST=127.0.0.1
PORT=8100
# Auto-restart the server when source files change. Set to false in production.
RELOAD=true

# ---- Model -------------------------------------------------------------
# The only place the model id is configured; nothing hardcodes it.
CLAUDE_MODEL=claude-sonnet-5

# ---- Tavus avatar (optional) -------------------------------------------
# Needed only when ENABLE_AVATAR=true. https://tavus.io/dashboard
TAVUS_API_KEY=

# The face the avatar wears. Defaults to a Tavus stock face, so you only need
# this to use your own trained face. List what is available with:
#   curl -H "x-api-key: $TAVUS_API_KEY" https://tavusapi.com/v2/faces?face_type=system
#   curl -H "x-api-key: $TAVUS_API_KEY" https://tavusapi.com/v2/faces?face_type=user
TAVUS_FACE_ID=

# The PAL that drives the face. Leave blank and the server creates one on
# first use, then logs its id to pin here (one per restart otherwise).
# Note: "replica"/"persona" are the retired names for face/PAL - old
# TAVUS_REPLICA_ID values are still read as a face id.
TAVUS_PAL_ID=

# --- Live conversation --------------------------------------------------
# Tavus runs the microphone, turn detection and interruptions, and asks THIS
# backend what to say next - which is what removes the push-to-talk button.
# So Tavus must be able to reach you over the public internet. Locally:
#   cloudflared tunnel --url http://localhost:8100
#   (or: ngrok http 8100)
# then paste the https URL here, with no trailing slash or path.
TAVUS_LLM_BASE_URL=

# Shared secret protecting /v1/chat/completions, which the tunnel exposes to
# the internet. Any long random string; generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
TAVUS_LLM_API_KEY=

# Turn-taking feel. Defaults suit an interview: patient enough to let someone
# think, still interruptible mid-sentence.
#   TAVUS_TURN_TAKING_PATIENCE  low | medium | high   (high = waits longer)
#   TAVUS_INTERRUPTIBILITY      low | medium | high   (high = yields easily)
#   TAVUS_IDLE_ENGAGEMENT       off | patient | eager (off = never nags)
TAVUS_TURN_TAKING_PATIENCE=high
TAVUS_INTERRUPTIBILITY=medium
TAVUS_IDLE_ENGAGEMENT=off

# ---- LiveKit (optional) ------------------------------------------------
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---- Email reports (optional) ------------------------------------------
# Needed only when ENABLE_EMAIL_NOTIFICATIONS=true.
# For Gmail use an App Password, not your account password:
# https://support.google.com/accounts/answer/185833
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=
SENDER_PASSWORD=
MANAGER_EMAIL=

# ---- Feature flags -----------------------------------------------------
# Set the avatar/email flags to false to run without those credentials.
ENABLE_AVATAR=true
ENABLE_LIVEKIT=true
ENABLE_EMAIL_NOTIFICATIONS=true
SAVE_TRANSCRIPTS=true

# ---- Interview shape ---------------------------------------------------
MAX_INTERVIEW_DURATION=45
WARMUP_QUESTIONS=2
CORE_QUESTIONS=5
ADVANCED_QUESTIONS=3
