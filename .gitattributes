# Line endings.
#
# Git on Windows defaults to core.autocrlf=true, which checks files out with
# CRLF. That is fine for Windows tools and fatal for anything a Linux container
# executes: a shell script with CRLF fails at the shebang with
#   /usr/bin/env: 'bash\r': No such file or directory
# So anything that runs inside a container, or is read by one, is pinned to LF
# regardless of the host.

*.sh            text eol=lf
*.Dockerfile    text eol=lf
Dockerfile      text eol=lf
*.yml           text eol=lf
*.yaml          text eol=lf
.env.example    text eol=lf
*.env.example   text eol=lf

# Native Windows scripts want CRLF - PowerShell and cmd.exe are the consumers,
# not a container.
*.ps1           text eol=crlf
*.bat           text eol=crlf
*.cmd           text eol=crlf

# Never touched: mangling these corrupts them.
*.png           binary
*.jpg           binary
*.jpeg          binary
*.ico           binary
*.pdf           binary
*.woff          binary
*.woff2         binary
